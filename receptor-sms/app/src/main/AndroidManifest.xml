<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Solo recibir: este celular nunca envía SMS. Se queda únicamente con los que empiezan con ENL -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- El servidor de la demo corre en la red local por http: ver res/xml/seguridad_red.xml -->
    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_action_email"
        android:label="@string/app_nombre"
        android:networkSecurityConfig="@xml/seguridad_red"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Solo el sistema puede entregar SMS_RECEIVED (permiso BROADCAST_SMS) -->
        <receiver
            android:name=".ReceptorSms"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
